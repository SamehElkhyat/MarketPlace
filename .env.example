# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# MongoDB MUST be a replica set (multi-document transactions): MongoDB Atlas (even the free M0) qualifies.
# Local dev: `docker compose up -d` or `npm run dev:db` (Docker-free, in-memory).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marketplace?retryWrites=true&w=majority

# Public URL of the STOREFRONT (used for links inside e-mails)
APP_URL=https://your-storefront.vercel.app

# Proxy hops in front of the API (Vercel + storefront rewrite). Adjust if rate limits see the wrong client IP.
TRUST_PROXY=1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
# Require a verified e-mail before an order can be placed (leave false for demos)
REQUIRE_VERIFIED_EMAIL_FOR_ORDERS=false
GOOGLE_CLIENT_ID=

# ── Rate limiting (Upstash Redis REST). Without it a per-instance in-memory limiter is used,
#    which is NOT shared between serverless instances — configure Upstash in production. ───────
# Multiplies every budget — keep 1 in production, raise only for E2E/load tests.
RATE_LIMIT_SCALE=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Images (signed direct uploads from the browser) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-mail: Resend in production (SMTP_URL is for local Mailpit only) ───────────────
RESEND_API_KEY=
EMAIL_FROM=Atelier <no-reply@your-domain.com>

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Payments ──────────────────────────────────────────────────────────────────
# Max cash-on-delivery order value in PIASTERS (2,000,000 = 20,000 EGP)
COD_MAX_AMOUNT=2000000
# Demo/test gateway. Keep false in production until Paymob/Fawry are live (online methods then show "coming soon").
PAYMENTS_MOCK_ENABLED=false
PAYMENTS_MOCK_SECRET=

# ── Storefront cache revalidation (Next.js on-demand) ───────────────────────────
REVALIDATE_URL=https://your-storefront.vercel.app/revalidate
REVALIDATE_SECRET=

# ── Seed script only (never needed on Vercel) ───────────────────────────────────
ADMIN_EMAIL=admin@atelier.test
ADMIN_PASSWORD=Admin#12345
DEMO_PASSWORD=Demo#12345
