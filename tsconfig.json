{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "handler.ts",
    "config",
    "controllers",
    "middleware",
    "models",
    "routes",
    "services",
    "utils",
    "validators",
    "types",
    "scripts",
    "test",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
